# Raw and generated data — not versioned here.
# Applies wherever these files sit (repo root, data/, jupyter_files/, etc).
*.csv
*.zip
*.parquet
*.xlsx

# Material that isn't ours to publish (client-provided instructions, decks).
*.pptx

# Draft/scratch material. data_cleaning/ and feature_engineering/ hold
# both the shipped backbone notebook and a lot of untracked draft
# versions in the same folder, so everything in each is ignored except
# the one backbone notebook (plus its jupytext mirror).
/jupyter_files/
/data_cleaning/*
!/data_cleaning/data_cleaning_backbone.ipynb
!/data_cleaning/data_cleaning_backbone.py
/feature_engineering/*
!/feature_engineering/feature_engineering_backbone.ipynb
!/feature_engineering/feature_engineering_backbone.py
/models/
/TEST DATA/
.ipynb_checkpoints/

# Jupyter / Python housekeeping
__pycache__/
*.pyc

# Local scratch: the sandbox this repo was assembled in can't delete files,
# so stray git lock/tmp files get moved here instead of removed.
_to_delete/

# OS / editor noise
.DS_Store
.vscode/
